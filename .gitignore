# ============================================================
# SkillCraft-AI — .gitignore
# Covers: Node.js, Python, Android, OS, IDE, Secrets
# ============================================================


# ============================================================
# NODE.JS / JAVASCRIPT / TYPESCRIPT
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.output/

# Package manager locks (keep one, ignore others as needed)
# Uncomment the ones you do NOT use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Caches
.npm
.eslintcache
.stylelintcache
.turbo
.parcel-cache/

# Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Storybook
storybook-static/

# Testing
coverage/
.nyc_output/


